rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        exists(/databases/$(database)/documents/admin/$(request.auth.uid))
      );
    }
    function isAgent() {
      return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'storefront_agent');
    }
    // Allow bootstrap: the designated admin phone can always self-elevate
    function isBootstrapAdmin() {
      return isSignedIn() && 
        request.auth.token.phone_number != null &&
        request.auth.token.phone_number.matches('.*9392849473$');
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isBootstrapAdmin() || 
        resource.data.role == 'agent' || 
        resource.data.role == 'storefront_agent'
      );
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Allow self-update; bootstrap admin can update their own role field
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() ||
        (isBootstrapAdmin() && request.auth.uid == userId)
      );
    }

    // Products
    match /products/{productId} {
      allow read: if true; // Publicly viewable
      allow write: if isAdmin() || isBootstrapAdmin(); // Only admin can add/edit
    }

    // Digital Product Content (Private)
    match /product_content/{contentId} {
      allow read: if isAdmin() || isBootstrapAdmin();
      allow write: if isAdmin() || isBootstrapAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isBootstrapAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || isBootstrapAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if isSignedIn(); // Users need to check if a coupon is valid
      allow write: if isAdmin() || isAgent() || isBootstrapAdmin(); // Agents generate coupons
    }

    // Global Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isBootstrapAdmin();
    }

    // Campaigns
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin() || isBootstrapAdmin();
    }

    // Lucky Draw Entries
    match /lucky_draw_entries/{entryId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if false; // Immutable ledger
      allow delete: if false; // Immutable ledger
    }

    // Tickets (Grievance Support)
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isBootstrapAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || isBootstrapAdmin();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || isBootstrapAdmin();
    }

    // Commissions (Privacy-focused tracking)
    match /commissions/{commissionId} {
      allow read: if isSignedIn() && (resource.data.agentUid == request.auth.uid || isAdmin() || isBootstrapAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin() || isBootstrapAdmin();
    }

    // Withdrawals
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (resource.data.agentUid == request.auth.uid || isAdmin() || isBootstrapAdmin());
      allow create: if isAgent();
      allow update: if isAdmin() || isBootstrapAdmin();
    }
  }
}
