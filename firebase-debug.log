[debug] [2026-05-10T04:09:27.607Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/bylyf-store-2026/rulesets {"name":"projects/bylyf-store-2026/rulesets/b4a2a3cf-841e-47d4-8bf4-9ca46a22a228","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // Helper functions\n    function isSignedIn() {\n      return request.auth != null;\n    }\n    function isAdmin() {\n      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';\n    }\n    function isAgent() {\n      return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'storefront_agent');\n    }\n    // Allow bootstrap: the designated admin phone can always self-elevate\n    function isBootstrapAdmin() {\n      return isSignedIn() && \n        request.auth.token.phone_number != null &&\n        request.auth.token.phone_number.matches('.*9392849473$');\n    }\n\n    // User Profiles\n    match /users/{userId} {\n      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isBootstrapAdmin());\n      allow create: if isSignedIn() && request.auth.uid == userId;\n      // Allow self-update; bootstrap admin can update their own role field\n      allow update: if isSignedIn() && (\n        request.auth.uid == userId || \n        isAdmin() ||\n        (isBootstrapAdmin() && request.auth.uid == userId)\n      );\n    }\n\n    // Products\n    match /products/{productId} {\n      allow read: if true; // Publicly viewable\n      allow write: if isAdmin() || isBootstrapAdmin(); // Only admin can add/edit\n    }\n\n    // Orders\n    match /orders/{orderId} {\n      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isBootstrapAdmin());\n      allow create: if isSignedIn();\n      allow update: if isAdmin() || isBootstrapAdmin();\n    }\n\n    // Coupons\n    match /coupons/{couponId} {\n      allow read: if isSignedIn(); // Users need to check if a coupon is valid\n      allow write: if isAdmin() || isAgent() || isBootstrapAdmin(); // Agents generate coupons\n    }\n\n    // Global Settings\n    match /settings/{settingId} {\n      allow read: if true;\n      allow write: if isAdmin() || isBootstrapAdmin();\n    }\n\n    // Lucky Draw Entries\n    match /lucky_draw_entries/{entryId} {\n      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isBootstrapAdmin());\n      allow create: if isSignedIn();\n      allow update: if isAdmin() || isBootstrapAdmin();\n    }\n\n    // Tickets (Grievance Support)\n    match /tickets/{ticketId} {\n      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isBootstrapAdmin());\n      allow create: if isSignedIn();\n      allow update: if isAdmin() || isBootstrapAdmin();\n    }\n\n    // Audit Logs\n    match /audit_logs/{logId} {\n      allow create: if isSignedIn();\n      allow read: if isAdmin() || isBootstrapAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-10T04:09:28.257103Z","metadata":{"services":["cloud.firestore"]}}
